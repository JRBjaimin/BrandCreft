{
  "name": "@brandcraft/motion",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scroll-scene": {
      "types": "./dist/useScrollScene.d.ts",
      "default": "./dist/useScrollScene.js"
    },
    "./success-burst": {
      "types": "./dist/SuccessBurst.d.ts",
      "default": "./dist/SuccessBurst.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(motion) no lint configured\"",
    "test": "echo \"(motion) no tests\""
  },
  "peerDependencies": {
    "framer-motion": "^11.0.0",
    "gsap": "^3.12.0",
    "lottie-react": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "framer-motion": "^11.11.17",
    "gsap": "^3.12.5",
    "lottie-react": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0"
  }
}
