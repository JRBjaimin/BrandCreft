# ---------------------------------------------------------------------------
# BrandCraft - environment template. Copy to .env and fill in real values.
# Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Backend API ---
API_PORT=4000
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://brandcraft:brandcraft@localhost:5432/brandcraft?schema=public

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- Object storage (S3-compatible / MinIO for local) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=brandcraft
S3_SECRET_KEY=brandcraft
S3_BUCKET=brandcraft-media
S3_FORCE_PATH_STYLE=true

# --- Integrations (Phase 0 validation required before use) ---
# WhatsApp Business Platform (Cloud API)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Meta / Instagram Graph API
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:4000/api/social/instagram/callback

# AI provider (Gemini initially)
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Market rate provider (must be licensed - see Phase 12)
RATE_PROVIDER=none
RATE_PROVIDER_API_KEY=

# --- Frontend apps ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
