# Backend reads the repo-root .env by default (see src/config/config.module.ts).
# This file exists so the backend can also run standalone. Copy to .env here
# only if you are not using the root .env.
#
# See ../../.env.example for the full annotated list.

NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://brandcraft:brandcraft@localhost:5432/brandcraft?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
